<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head') %>
    <title>Blog</title>
</head>
<body>
     <%- include('./partials/navbar') %>

     <div class="container mt-4">
        <h1><%= blog.title %></h1>
        <img src="<%= blog.coverImageId ? '/blog/image/' + blog.coverImageId : blog.coverImageURL %>" alt="" width="400vh">
        <p><%= blog.body %></p>

     </div>
   <div class="container mt-4" >
      <% if (blog.createdBy) { %>
        <img src="<%= blog.createdBy.profilePhotoURL %>" alt="" width="50px">
        <%= blog.createdBy.fullName %>
      <% } else { %>
        <span>Author unavailable</span>
      <% } %>
   </div>
   <div class="container mt-3">
    <h1>Comments (<%= comments.length %>)</h1>
  <% if (locals.user) { %>
  <form action="/blog/comment/<%= blog._id %>" method="POST">
  <div class="mb-3">
    <input
      type="text"
      class="form-control"
      id="content"
      name="content"
      required
    >
  </div>
  <button type="submit" class="btn btn-primary">Add</button>
</form>
  <% } %>

   <div class="mt-3">
    <% comments.forEach(comment => { %>
    <div>
        <% if (comment.createdBy) { %>
          <img src="<%= comment.createdBy.profilePhotoURL %>" alt="" width="50px">
          <%= comment.createdBy.fullName %>
        <% } else { %>
          <span>Deleted user</span>
        <% } %>:<pre><%= comment.content %></pre>
    </div>
    <% }) %>

 </div>

   </div>
          <%- include('./partials/scripts') %>
</body>
</html>